# .gitignore for ArogyaNova

# Environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
*.db
*.sqlite
*.sqlite3

# Node
node_modules/
dist/
.pnpm-store/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes
postgres_data/

# Uploads (but keep directory)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
logs/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml
