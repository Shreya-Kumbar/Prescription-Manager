# Database settings
DATABASE_URL=postgresql+asyncpg://arogyanova:arogyanova_dev_pass@localhost:5432/arogyanova
POSTGRES_USER=arogyanova
POSTGRES_PASSWORD=arogyanova_dev_pass
POSTGRES_DB=arogyanova

# Security
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development
DEBUG=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Upload settings
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
