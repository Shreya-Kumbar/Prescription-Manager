# ============================================================
# ArogyaNova — Environment Configuration
# ============================================================
# Copy this file to .env and edit if needed.
# For LOCAL DEVELOPMENT, NO CHANGES REQUIRED.
# SQLite is used by default — zero-config, no install needed.
# ============================================================

# --- Database ---
# Default: SQLite (works immediately, no PostgreSQL needed)
DATABASE_URL=sqlite+aiosqlite:///./arogyanova.db

# For PostgreSQL production setup, replace the line above with:
# DATABASE_URL=postgresql+asyncpg://arogyanova:arogyanova_dev_pass@localhost:5432/arogyanova

# --- Security ---
# Provided default is fine for local development.
# ALWAYS override with a long random string in production.
SECRET_KEY=arogyanova-super-secret-development-key-32chars-min-length-ok
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Environment ---
ENVIRONMENT=development
DEBUG=true

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Upload settings ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
